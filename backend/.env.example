# ==============================================================================
# BACKEND SERVER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env or .env.<environment> for local development / deployment.
# Fill in your own credentials. DO NOT commit files containing actual secrets to Git.
#
# Environment precedence:
# .env.<NODE_ENV>.local > .env.<NODE_ENV> > .env.local > .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS (REQUIRED)
# ------------------------------------------------------------------------------
# Active environment: development | staging | production | test
NODE_ENV=development

# Express HTTP listener port
PORT=3000

# Client web origin for CORS policies and redirection callbacks
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE & AUTHENTICATION (REQUIRED)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>)
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/production_db

# Cryptographic secret for signing and verifying JWT tokens (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# ------------------------------------------------------------------------------
# 3. AI & LANGUAGE MODELS (REQUIRED)
# ------------------------------------------------------------------------------
# Google Gemini API key (v2.5 Flash used for AI studio content generation)
GEMINI_API_KEY=AIzaSyExampleGeminiApiKey1234567890

# [OPTIONAL] Local Ollama API URL
OLLAMA_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. SWYTCHCODE INTEGRATION ENGINE (REQUIRED)
# ------------------------------------------------------------------------------
# Workspace identifier for telemetry and canonical tool execution
SWYTCHCODE_WORKSPACE_ID=ws_example_community_ops

# Swytchcode Execution Environment: sandbox | live
SWYTCHCODE_ENV=sandbox

# Swytchcode API Base Endpoint
SWYTCHCODE_BASE_URL=https://api.swytchcode.com/v1

# [OPTIONAL] Swytchcode API Key (only needed if calling live Swytchcode API)
SWYTCHCODE_API_KEY=sc_live_exampleApiKeyHere

# ------------------------------------------------------------------------------
# 5. SOCIAL CHANNELS - TELEGRAM (REQUIRED)
# ------------------------------------------------------------------------------
# Telegram Bot API Token issued by @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ123456789

# Telegram Bot username handle without '@'
TELEGRAM_BOT_USERNAME=YourBotUsername

# Default target Telegram chat or channel ID for broadcasts
TELEGRAM_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# 6. SOCIAL CHANNELS - NOTION (REQUIRED)
# ------------------------------------------------------------------------------
# Notion Parent Page or Database UUID for automated content archival
NOTION_PAGE_ID=a1b2c3d4e5f67890123456789abcdef0

# ------------------------------------------------------------------------------
# 7. MEDIA SEARCH & ASSETS (REQUIRED)
# ------------------------------------------------------------------------------
# Pixabay API Key for AI studio image search
PIXABAY_API_KEY=12345678-abcdef0123456789abcdef012

# Jamendo Client ID for background audio tracks
JAMENDO_CLIENT_ID=12345678

# [OPTIONAL] Unsplash Access Key
UNSPLASH_ACCESS=your_unsplash_access_key

# [OPTIONAL] Pexels API Key
PEXELS_API_KEY=your_pexels_api_key

# [OPTIONAL] Freepik API Key
FREEPIK_API_KEY=your_freepik_api_key

# ------------------------------------------------------------------------------
# 8. SOCIAL CHANNELS - X / TWITTER (OPTIONAL)
# ------------------------------------------------------------------------------
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_secret
X_BEARER_TOKEN=your_x_bearer_token

# Secondary X Account (Optional)
ACCOUNT_2_X_API_KEY=your_account_2_x_api_key
ACCOUNT_2_X_API_SECRET=your_account_2_x_api_secret
ACCOUNT_2_X_ACCESS_TOKEN=your_account_2_x_access_token
ACCOUNT_2_X_ACCESS_SECRET=your_account_2_x_access_secret

# ------------------------------------------------------------------------------
# 9. SOCIAL CHANNELS - LINKEDIN (OPTIONAL)
# ------------------------------------------------------------------------------
LI_ACCESS_TOKEN1=your_linkedin_token_1
LI_AUTHOR_URN1=urn:li:person:12345678
LI_ACCESS_TOKEN2=your_linkedin_token_2
LI_AUTHOR_URN2=urn:li:person:87654321

# ------------------------------------------------------------------------------
# 10. SOCIAL CHANNELS - INSTAGRAM (OPTIONAL)
# ------------------------------------------------------------------------------
IG_TOKEN=your_meta_graph_api_long_lived_token
IG_PAGE_ID_1=100000000000001
IG_PAGE_ID_2=100000000000002
IG_PAGE_ID_3=100000000000003

# ------------------------------------------------------------------------------
# 11. MEDIA STORAGE & RENDERING (OPTIONAL)
# ------------------------------------------------------------------------------
# ImageKit CDN
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
BUCKET_NAME=reels

# Rendering Binaries & Fonts
FONT_PATH=C:/Windows/Fonts/arialbd.ttf
FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# YouTube Downloader
YOUTUBE_DOWNLOAD_TIMEOUT_MS=120000
YOUTUBE_COOKIES_FROM_BROWSER=
YOUTUBE_COOKIES_FILE=cookies.txt

# ------------------------------------------------------------------------------
# 12. EMAIL SERVICE (OPTIONAL)
# ------------------------------------------------------------------------------
USER_EMAIL=notifications@example.com
USER_PASSWORD=your_email_app_password

# ------------------------------------------------------------------------------
# 13. GOOGLE OAUTH2 (OPTIONAL)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
