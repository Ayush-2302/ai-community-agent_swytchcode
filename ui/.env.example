# ==============================================================================
# FRONTEND CLIENT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# Only variables prefixed with VITE_* are exposed to client code via import.meta.env.
# NEVER place backend secrets, database passwords, or private API keys here.
# ==============================================================================

# [REQUIRED] Backend API Base URL
VITE_API_BASE_URL=http://localhost:3000/api/social

# [OPTIONAL] Request timeout in milliseconds (default: 15000)
VITE_API_TIMEOUT=15000

# [OPTIONAL] Application display name
VITE_APP_NAME="SocialOps Console"

# [OPTIONAL] Environment name (development | staging | production)
VITE_APP_ENV=development

# [OPTIONAL] Swytchcode Public Workspace Identifier
VITE_SWYTCHCODE_WORKSPACE_ID=ws_example_workspace
